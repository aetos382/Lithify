root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

spelling_languages = en-us
spelling_checkable_types = identifiers,strings,comments
spelling_error_severity = warning
spelling_exclusion_path = exclude.dic
spelling_use_default_exclusion_dictionary = true

[**/*{.-}lock.json]
generated_code = true
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
