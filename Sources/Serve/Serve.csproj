<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hosting\Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP サーバーを持つのでここだけ ASP.NET Core を要求する。
         Lithify.Hosting に混ぜると build しかしない利用者にも付いてくる。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Description>Development server for Lithify, with on-demand builds and live reload.</Description>
  </PropertyGroup>

</Project>
